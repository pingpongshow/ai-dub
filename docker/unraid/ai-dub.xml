<?xml version="1.0"?>
<Container version="2">
  <Name>ai-dub</Name>
  <Repository>ghcr.io/pingpongshow/ai-dub:latest</Repository>
  <Registry>https://github.com/pingpongshow/ai-dub/pkgs/container/ai-dub</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/pingpongshow/ai-dub/issues</Support>
  <Project>https://github.com/pingpongshow/ai-dub</Project>
  <Overview>Local, voice-cloned dubbing of foreign-language video into English. Adds an "English (AI dub)" audio track to your own media files. Needs an NVIDIA GPU (32 GB recommended). Models are downloaded on first use from the Models page.</Overview>
  <Category>MediaApp:Video</Category>
  <WebUI>http://[IP]:[PORT:8790]/</WebUI>
  <Icon>https://raw.githubusercontent.com/pingpongshow/ai-dub/main/docker/unraid/icon.png</Icon>
  <ExtraParams>--runtime=nvidia</ExtraParams>
  <Config Name="Web UI" Target="8790" Default="8790" Mode="tcp" Type="Port" Display="always" Required="true"/>
  <Config Name="App data" Target="/config" Default="/mnt/user/appdata/ai-dub/appdata" Mode="rw" Type="Path" Display="always" Required="true" Description="Settings, keys, job database, show profiles"/>
  <Config Name="Models" Target="/models" Default="/mnt/user/appdata/ai-dub/models" Mode="rw" Type="Path" Display="always" Required="true" Description="Model weights and environments (tens of GB)"/>
  <Config Name="Work" Target="/work" Default="/mnt/user/appdata/ai-dub/work" Mode="rw" Type="Path" Display="always" Required="true" Description="Temporary per-job files, deleted when a job completes"/>
  <Config Name="Movies" Target="/media/movies" Default="/mnt/user/media/movies" Mode="rw" Type="Path" Display="always" Required="false" Description="Read-write so tracks can be added"/>
  <Config Name="Shows" Target="/media/shows" Default="/mnt/user/media/shows" Mode="rw" Type="Path" Display="always" Required="false"/>
  <Config Name="Anime" Target="/media/anime" Default="/mnt/user/media/anime" Mode="rw" Type="Path" Display="always" Required="false"/>
  <Config Name="GPU" Target="NVIDIA_VISIBLE_DEVICES" Default="all" Mode="" Type="Variable" Display="always" Required="true"/>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Type="Variable" Display="advanced" Required="true"/>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Type="Variable" Display="advanced" Required="true"/>
  <Config Name="Install models on start" Target="AIDUB_INSTALL_ON_START" Default="false" Mode="" Type="Variable" Display="advanced" Required="false" Description="true = download every missing model when the container starts"/>
</Container>
